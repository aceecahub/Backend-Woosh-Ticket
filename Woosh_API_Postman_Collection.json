        },
        {
          "name": "Get Train by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/trains/1"
          }
        },
        {
          "name": "Create Train - Woosh Express",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/trains",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"train_name\": \"Woosh Express\",\n    \"train_code\": \"WSH-001\",\n    \"total_seats\": 600\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Create Train - Woosh Premium",
          "request": {
            "method": "POST",
            "header": [],
