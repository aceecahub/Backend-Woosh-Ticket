{
  "info": {
    "name": "WOOSH Ticket API",
    "description": "Koleksi API lengkap untuk testing seluruh modul aplikasi pemesanan tiket kereta Woosh.\n\nAlur testing:\n1. Register & Login (dapatkan token)\n2. Setup data master (Station, Train, Seat)\n3. Buat Schedule\n4. Search Schedule\n5. Cek Available Seats\n6. Create Booking\n7. Create Payment\n8. Payment Callback (simulasi gateway)\n9. Generate Ticket\n10. Scan Ticket (Check-in)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"full_name\": \"Budi Santoso\",\n    \"email\": \"budi@example.com\",\n    \"phone\": \"081234567890\",\n    \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"full_name\": \"Admin Woosh\",\n    \"email\": \"admin@woosh.com\",\n    \"phone\": \"081999999999\",\n    \"password\": \"admin123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token tersimpan:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"budi@example.com\",\n    \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "2. Stations",
      "item": [
        {
          "name": "Get All Stations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/stations"
          }
        },
        {
          "name": "Get Station by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/stations/1"
          }
        },
        {
          "name": "Create Station - Halim",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/stations",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"station_name\": \"Halim\",\n    \"city\": \"Jakarta Timur\",\n    \"code\": \"HLM\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Create Station - Karawang",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/stations",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"station_name\": \"Karawang\",\n    \"city\": \"Karawang\",\n    \"code\": \"KRW\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Create Station - Padalarang",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/stations",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"station_name\": \"Padalarang\",\n    \"city\": \"Bandung Barat\",\n    \"code\": \"PDL\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Create Station - Tegalluar",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/stations",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"station_name\": \"Tegalluar\",\n    \"city\": \"Bandung\",\n    \"code\": \"TGL\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Update Station",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{base_url}}/stations/1",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"station_name\": \"Stasiun Halim Baru\",\n    \"city\": \"Jakarta Timur\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete Station",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/stations/4"
          }
        }
      ]
    },
    {
      "name": "3. Trains",
      "item": [
        {
          "name": "Get All Trains",
          "request": {
            "method": "GET",
            "header": [],
